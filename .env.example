# Database credentials loaded automatically by docker compose (env_file: .env)
# Copy this file to .env and change the passwords. Never commit .env.

POSTGRES_USER=boxmatrix
POSTGRES_PASSWORD=boxmatrix
POSTGRES_DB=boxmatrix
POSTGRES_PORT=5432

# Separate write / read passwords
WRITER_PASSWORD=boxmatrix_writer_pw
READER_PASSWORD=boxmatrix_reader_pw
