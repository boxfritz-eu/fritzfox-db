# Database and application configuration loaded automatically by docker compose (env_file: .env)
# Copy this file to .env and change the passwords. Never commit .env.

# Application / Container / Image naming
APP_NAME=boxmatrix
POSTGRES_CONTAINER_NAME=boxmatrix-postgres
PGADMIN_CONTAINER_NAME=boxmatrix-pgadmin
POSTGRES_IMAGE=ghcr.io/kugeleis/boxmatrix-loader-db:latest

# PostgreSQL credentials and port
POSTGRES_USER=boxmatrix
POSTGRES_PASSWORD=boxmatrix
POSTGRES_DB=boxmatrix
POSTGRES_PORT=5432

# Separate write / read passwords
WRITER_PASSWORD=boxmatrix_writer_pw
READER_PASSWORD=boxmatrix_reader_pw

# pgAdmin configuration
PGADMIN_PORT=5433
PGADMIN_DEFAULT_EMAIL=boxmatrix@foobarpg.org
